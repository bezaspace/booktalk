#!/usr/bin/env bash
# sf — start BookTalk frontend (Vite dev server on :5173)
# Run from anywhere; cd's into the frontend dir automatically.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/frontend"

if [[ ! -d node_modules ]]; then
  echo "First run: installing frontend dependencies with npm..."
  npm install
fi

exec npm run dev
